.card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:22px}
.work-card{
  position:relative;border-radius:var(--radius);overflow:hidden;
  background:linear-gradient(160deg,rgba(28,22,43,.94),rgba(20,14,33,.96));
  border:1.5px solid rgba(139,92,246,.55);
  box-shadow:0 0 18px rgba(147,51,234,.16);
  transition:transform .34s var(--ease), border-color .34s, box-shadow .34s;
}
.work-card:hover{transform:translateY(-6px);border-color:#c084fc;
  box-shadow:0 16px 40px rgba(147,51,234,.4)}
.work-thumb{
  position:relative;aspect-ratio:16/9;overflow:hidden;
  background:
    radial-gradient(circle at 30% 20%,rgba(192,38,211,.55),transparent 55%),
    radial-gradient(circle at 80% 80%,rgba(126,34,206,.65),transparent 60%),
    linear-gradient(135deg,#241638,#130d20);
}
.work-thumb::after{
  content:'';position:absolute;inset:0;
  background-image:radial-gradient(rgba(255,255,255,.16) 1px,transparent 1px);
  background-size:14px 14px;opacity:.5;
  transition:transform .6s var(--ease);
}
.work-card:hover .work-thumb::after{transform:scale(1.25) rotate(4deg)}
.play-btn{
  position:absolute;inset:0;margin:auto;width:56px;height:56px;border-radius:50%;
  display:grid;place-items:center;
  background:rgba(17,12,28,.55);backdrop-filter:blur(4px);
  border:1.5px solid rgba(232,121,249,.9);
  box-shadow:0 0 22px rgba(192,38,211,.7);
  transition:transform .35s var(--ease), background .35s;
}
.work-card:hover .play-btn{transform:scale(1.14);background:rgba(147,51,234,.6)}
.play-btn svg{width:19px;height:19px;fill:#fff;margin-left:3px}
.work-body{padding:18px 20px 22px}
.work-body h3{font-family:'Hind Siliguri',sans-serif;font-size:1rem;font-weight:700}
.work-body p{font-family:'Hind Siliguri',sans-serif;font-size:.84rem;color:#9a8db0;margin-top:4px}
.work-tag{
  display:inline-block;margin-top:12px;font-size:.7rem;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;padding:4px 11px;border-radius:99px;
  color:#e9d5ff;background:rgba(147,51,234,.22);border:1px solid rgba(168,85,247,.5);
}

/* graphic tiles */
.g-tile{
  position:relative;border-radius:16px;overflow:hidden;aspect-ratio:4/5;
  border:1.5px solid rgba(139,92,246,.55);
  display:grid;place-items:center;
  background:linear-gradient(150deg,#241638,#130d20);
  transition:transform .34s var(--ease), box-shadow .34s, border-color .34s;
}
.g-tile:hover{transform:translateY(-6px) rotate(-1.2deg);border-color:#e879f9;
  box-shadow:0 16px 38px rgba(168,85,247,.42)}
.g-tile::before{
  content:'';position:absolute;inset:-40%;
  background:conic-gradient(from 0deg,transparent,rgba(192,132,252,.32),transparent 30%);
  animation:spin 8s linear infinite;opacity:.85;
}
.g-tile .g-inner{
  position:relative;z-index:1;width:calc(100% - 16px);height:calc(100% - 16px);
  border-radius:11px;display:grid;place-items:center;text-align:center;padding:16px;
  background:rgba(17,12,28,.86);backdrop-filter:blur(3px);
  font-family:'Hind Siliguri',sans-serif;font-weight:700;font-size:.9rem;color:#e9d5ff;
}
.g-tile .g-inner small{display:block;font-size:.68rem;letter-spacing:.2em;
  color:#a78bfa;margin-top:6px;text-transform:uppercase}

/* ============ CONTACT ============ */
.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:32px;align-items:start}
.contact-info{display:grid;gap:14px}
.ci-item{
  display:flex;gap:14px;align-items:center;padding:16px 18px;border-radius:14px;
  background:rgba(28,22,43,.82);border:1.5px solid rgba(139,92,246,.45);
  transition:transform .3s var(--ease), border-color .3s, box-shadow .3s;
}
.ci-item:hover{transform:translateX(5px);border-color:#c084fc;box-shadow:0 0 22px rgba(168,85,247,.38)}
.ci-ico{
  width:42px;height:42px;flex-shrink:0;border-radius:11px;display:grid;place-items:center;
  background:linear-gradient(145deg,#8b5cf6,#6d28d9);
  box-shadow:0 0 16px rgba(168,85,247,.6);
}
.ci-ico svg{width:19px;height:19px;fill:#fff}
.ci-item b{display:block;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:#a78bfa}
.ci-item span{font-family:'Hind Siliguri',sans-serif;font-size:.94rem;color:#e5dcf5}

form{
  padding:30px;border-radius:var(--radius);
  background:linear-gradient(160deg,rgba(28,22,43,.94),rgba(20,14,33,.96));
  border:1.5px solid rgba(139,92,246,.55);
  box-shadow:0 0 24px rgba(147,51,234,.2);
}
.field{margin-bottom:16px}
.field label{
  display:block;font-family:'Hind Siliguri',sans-serif;font-size:.82rem;font-weight:600;
  color:#c4b5fd;margin-bottom:7px;
}
.field input,.field textarea{
  width:100%;padding:13px 16px;border-radius:11px;
  background:rgba(17,12,28,.9);color:#fff;
  border:1.5px solid rgba(126,34,206,.55);
  font-family:'Hind Siliguri','Inter',sans-serif;font-size:.94rem;
  transition:border-color .28s, box-shadow .28s, background .28s;
}
.field input::placeholder,.field textarea::placeholder{color:#6b5d84}
.field input:focus,.field textarea:focus{
  outline:none;border-color:#c084fc;background:rgba(28,22,43,.95);
  box-shadow:0 0 0 3px rgba(168,85,247,.18),0 0 20px rgba(168,85,247,.28);
}
.field textarea{resize:vertical;min-height:120px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
form .btn-primary{width:100%;justify-content:center;margin-top:6px}
.toast{
  margin-top:14px;padding:12px 16px;border-radius:11px;
  background:rgba(147,51,234,.2);border:1px solid rgba(192,132,252,.65);
  color:#e9d5ff;font-family:'Hind Siliguri',sans-serif;font-size:.88rem;
  opacity:0;transform:translateY(-6px);transition:all .35s var(--ease);
}
.toast.show{opacity:1;transform:translateY(0)}

/* ============ CTA STRIP ============ */
.thanks{
  margin:0 auto;max-width:900px;text-align:center;padding:34px 26px;border-radius:20px;
  background:linear-gradient(90deg,#b829ff 0%,#d946ef 50%,#9333ea 100%);
  box-shadow:0 0 34px rgba(217,70,239,.55);
  position:relative;overflow:hidden;
}
.thanks::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);
  transform:translateX(-120%);animation:sheen 4.5s ease-in-out infinite;
}
@keyframes sheen{0%,60%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
.thanks h3{font-family:'Hind Siliguri',sans-serif;font-size:1.25rem;font-weight:700;position:relative;z-index:1}
.thanks p{font-family:'Hind Siliguri',sans-serif;font-size:.92rem;opacity:.92;margin-top:6px;position:relative;z-index:1}

/* ============ FOOTER ============ */
footer{
  position:relative;z-index:1;margin-top:40px;padding:52px 0 34px;
  border-top:1px solid rgba(126,34,206,.4);
  background:linear-gradient(180deg,rgba(24,17,39,.5),rgba(17,12,28,1));
}
.foot-grid{display:flex;flex-wrap:wrap;gap:34px;justify-content:space-between;align-items:flex-start}
.foot-brand{display:flex;gap:14px;align-items:center;max-width:340px}
.foot-brand .brand-mark{width:56px;height:56px}
.foot-brand p{font-family:'Hind Siliguri',sans-serif;font-size:.86rem;color:#9a8db0;margin-top:6px}
.foot-links{display:flex;flex-wrap:wrap;gap:8px 22px}
.foot-links a{font-family:'Hind Siliguri',sans-serif;font-size:.9rem;color:#c4b5fd;
  transition:color .25s, text-shadow .25s}
.foot-links a:hover{color:#fff;text-shadow:0 0 14px rgba(192,132,252,.9)}
.socials{display:flex;gap:10px}
.socials a{
  width:40px;height:40px;border-radius:11px;display:grid;place-items:center;
  background:rgba(28,22,43,.9);border:1.5px solid rgba(139,92,246,.5);
  transition:all .3s var(--ease);
}
.socials a:hover{transform:translateY(-4px);border-color:#e879f9;
  box-shadow:0 0 20px rgba(168,85,247,.7);background:rgba(147,51,234,.28)}
.socials svg{width:17px;height:17px;fill:#c4b5fd}
.socials a:hover svg{fill:#fff}
.copyright{
  margin-top:34px;padding-top:22px;border-top:1px solid rgba(126,34,206,.28);
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;
  font-size:.8rem;color:#7d7194;
}
.copyright b{color:#c084fc}

/* ============ SCROLL REVEAL ============ */
.reveal{opacity:0;transform:translateY(30px);
  transition:opacity .8s var(--ease), transform .8s var(--ease);
  transition-delay:var(--d,0ms)}
.reveal.in{opacity:1;transform:none}

/* ============ BACK TO TOP ============ */
#toTop{
  position:fixed;right:22px;bottom:22px;z-index:70;
  width:48px;height:48px;border-radius:14px;display:grid;place-items:center;cursor:pointer;
  background:linear-gradient(145deg,#9333ea,#6d28d9);color:#fff;border:none;
  box-shadow:0 0 22px rgba(168,85,247,.65);
  opacity:0;pointer-events:none;transform:translateY(14px);
  transition:all .35s var(--ease);
}
#toTop.show{opacity:1;pointer-events:auto;transform:none}
#toTop:hover{box-shadow:0 0 32px rgba(232,121,249,.95)}
#toTop svg{width:20px;height:20px;fill:#fff}

/* ============ RESPONSIVE ============ */
@media(max-width:960px){
  .hero-grid{grid-template-columns:1fr;gap:44px}
  .pp-stage{order:-1}
  .contact-grid{grid-template-columns:1fr}
  .timeline::before{left:18px}
  .timeline::after{left:16px}
  .office-card{grid-template-columns:40px 1fr;gap:12px;padding:18px 0 18px 0}
  .oc-node{width:40px;padding-top:22px}
}
@media(max-width:760px){
  .nav-links{
    position:fixed;inset:80px 0 auto 0;flex-direction:column;align-items:stretch;
    background:rgba(17,12,28,.98);backdrop-filter:blur(16px);
    padding:18px 22px 26px;gap:6px;
    border-bottom:1px solid rgba(126,34,206,.5);
    transform:translateY(-140%);transition:transform .4s var(--ease);
    max-height:calc(100vh - 80px);overflow:auto;
  }
  .nav-links.open{transform:translateY(0)}
  .nav-links a{padding:13px 16px;font-size:1rem}
  .nav-cta{display:none}