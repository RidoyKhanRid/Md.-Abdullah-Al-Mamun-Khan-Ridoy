.pp-replay svg{width:15px;height:15px;transition:transform .5s var(--ease)}
.pp-replay:hover svg{transform:rotate(-180deg)}

/* ============ SECTION HEADS ============ */
.sec-head{text-align:center;margin-bottom:56px}
.sec-kicker{
  display:inline-block;font-size:.74rem;letter-spacing:.3em;text-transform:uppercase;
  color:#c084fc;font-weight:800;margin-bottom:14px;
}
