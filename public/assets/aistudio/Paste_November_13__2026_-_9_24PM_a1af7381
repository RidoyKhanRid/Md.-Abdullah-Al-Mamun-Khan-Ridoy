  background:radial-gradient(600px circle at var(--mx,50%) var(--my,0%),rgba(192,132,252,.16),transparent 42%);
  opacity:0;transition:opacity .35s;
}
.oc-body:hover::before{opacity:1}
.oc-body:hover{
  transform:translateY(-4px);
