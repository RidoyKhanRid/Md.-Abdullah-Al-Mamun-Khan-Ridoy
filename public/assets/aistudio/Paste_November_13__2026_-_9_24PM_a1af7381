.stat span{font-size:.78rem;color:var(--ink-dim);font-family:'Hind Siliguri',sans-serif}

/* ============ PROFILE 2D REVEAL ============ */
.pp-stage{display:flex;flex-direction:column;align-items:center;gap:22px}
.pp{
  position:relative;width:min(370px,78vw);aspect-ratio:1/1;
  isolation:isolate;
}
/* ambient glow */
.pp::before{
  content:'';position:absolute;inset:-14%;border-radius:50%;
  background:radial-gradient(circle,rgba(168,85,247,.42),transparent 68%);
  filter:blur(26px);z-index:0;animation:breathe 5s ease-in-out infinite;
}
@keyframes breathe{50%{transform:scale(1.12);opacity:.75}}

/* rotating dashed orbit (always running) */
.pp-orbit{
  position:absolute;inset:-9%;z-index:1;
  animation:spin 22s linear infinite;
}
.pp-orbit svg{width:100%;height:100%;overflow:visible}
.pp-orbit circle{
  fill:none;stroke:rgba(192,132,252,.55);stroke-width:.7;
  stroke-dasharray:3 7;stroke-linecap:round;
}
@keyframes spin{to{transform:rotate(360deg)}}

/* image frame */
.pp-frame{
  position:absolute;inset:6%;border-radius:50%;overflow:hidden;z-index:3;
  background:#1c162b;
  border:2px solid var(--purple-neon);
  box-shadow:0 0 40px rgba(168,85,247,.6), inset 0 0 34px rgba(168,85,247,.22);
}
.pp-frame::after{
  content:'';position:absolute;inset:0;border-radius:50%;
  background:radial-gradient(circle at 50% 12%,rgba(168,85,247,.28),transparent 58%);
  pointer-events:none;
}
.pp-frame img{
  width:100%;height:100%;object-fit:cover;object-position:top center;
  transform:scale(1.42);opacity:0;
  filter:saturate(.75) contrast(1.05) brightness(.92);
}

/* STAGE 1: circle wipe on image */
.pp.is-playing .pp-frame img{
  animation:imgIn 1.25s .35s cubic-bezier(.19,1,.22,1) forwards,
            colorUp 1.1s 1.15s ease forwards;
}
@keyframes imgIn{
  0%{opacity:0;transform:scale(1.42);clip-path:circle(0% at 50% 50%)}
  35%{opacity:1}
  100%{opacity:1;transform:scale(1.02);clip-path:circle(72% at 50% 50%)}
}
@keyframes colorUp{
  from{filter:saturate(.75) contrast(1.05) brightness(.92)}
  to{filter:saturate(1.02) contrast(1.03) brightness(1)}
}

/* STAGE 2: purple disc sweep away */
.pp-disc{
  position:absolute;inset:6%;border-radius:50%;z-index:6;
  background:conic-gradient(from 210deg,#7e22ce,#c026d3,#a855f7,#4c1d95,#a855f7);
  box-shadow:0 0 44px rgba(192,38,211,.7), inset 0 0 30px rgba(0,0,0,.45);
  transform-origin:70% 120%;
}
.pp.is-playing .pp-disc{animation:discOut 1.1s .12s cubic-bezier(.85,0,.15,1) forwards}
@keyframes discOut{
  0%{transform:scale(1) rotate(0);opacity:1}
  55%{transform:scale(1.06) rotate(-14deg);opacity:1}
  100%{transform:scale(.05) rotate(-46deg);opacity:0}
}

/* STAGE 3: SVG ring draws */
.pp-ring{position:absolute;inset:-3%;z-index:7;pointer-events:none}
.pp-ring svg{width:100%;height:100%;overflow:visible;transform:rotate(-90deg)}
.pp-ring .track{
  fill:none;stroke:rgba(168,85,247,.16);stroke-width:1.6;
}
.pp-ring .draw{
  fill:none;stroke:url(#ringGrad);stroke-width:2.6;stroke-linecap:round;
  stroke-dasharray:302;stroke-dashoffset:302;
  filter:drop-shadow(0 0 8px rgba(232,121,249,.9));
}
.pp.is-playing .pp-ring .draw{animation:drawRing 1.3s .45s cubic-bezier(.6,0,.2,1) forwards}
@keyframes drawRing{to{stroke-dashoffset:0}}

/* STAGE 4: scan sweep */
.pp-scan{
  position:absolute;left:6%;right:6%;top:6%;height:16%;z-index:8;
  border-radius:50%/60%;
  background:linear-gradient(180deg,transparent,rgba(232,121,249,.85),rgba(255,255,255,.85),transparent);
  filter:blur(3px);opacity:0;pointer-events:none;mix-blend-mode:screen;
}
.pp.is-playing .pp-scan{animation:scanSweep 1.35s .95s cubic-bezier(.5,0,.5,1) 1}
@keyframes scanSweep{
  0%{opacity:0;transform:translateY(-30%) scaleX(.4)}
  15%{opacity:1}
  85%{opacity:.9}
  100%{opacity:0;transform:translateY(430%) scaleX(1)}
}

/* STAGE 5: burst sparks (generated by JS) */
.pp-spark{
  position:absolute;left:50%;top:50%;width:9px;height:9px;margin:-4.5px 0 0 -4.5px;
  border-radius:50%;z-index:9;opacity:0;pointer-events:none;
  background:#f0abfc;box-shadow:0 0 12px #e879f9,0 0 22px rgba(168,85,247,.8);
}
.pp.is-playing .pp-spark{animation:sparkFly .95s ease-out forwards}
@keyframes sparkFly{
  0%{opacity:0;transform:translate(0,0) scale(.2)}
  25%{opacity:1}
  100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(1.15)}
}

/* caption */
.pp-caption{text-align:center;opacity:0;transform:translateY(16px)}
.pp.is-playing ~ .pp-caption,
.pp-caption.in{animation:capIn .8s 1.65s var(--ease) forwards}
@keyframes capIn{to{opacity:1;transform:translateY(0)}}
.pp-caption h3{font-size:1rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.pp-caption p{font-family:'Hind Siliguri',sans-serif;font-size:.86rem;color:#a78bfa;letter-spacing:.04em}

.pp-replay{
