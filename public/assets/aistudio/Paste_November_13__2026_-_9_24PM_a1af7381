/* ============ OFFICE TIMELINE CARDS ============ */
.timeline{position:relative;display:flex;flex-direction:column;gap:22px;padding-left:0}
.timeline::before{
  content:'';position:absolute;left:26px;top:12px;bottom:12px;width:2px;
  background:linear-gradient(180deg,rgba(168,85,247,0),rgba(168,85,247,.85),rgba(192,38,211,.65),rgba(168,85,247,0));
  box-shadow:0 0 14px rgba(168,85,247,.7);
}
.timeline::after{
  content:'';position:absolute;left:24px;top:0;width:6px;height:60px;border-radius:99px;
  background:linear-gradient(180deg,#e879f9,transparent);filter:blur(3px);
  animation:lineRun 5s ease-in-out infinite;
}
@keyframes lineRun{0%,100%{top:0;opacity:0}20%{opacity:1}80%{opacity:1}90%{top:80%;opacity:0}}

.office-card{
  position:relative;display:grid;grid-template-columns:56px 1fr;gap:20px;
  padding:24px 26px 24px 0;
}
.oc-node{
